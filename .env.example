# Copy to .env.local for local development. Never commit real secrets.

NEXT_PUBLIC_DEV_ROLE_SWITCHER=false

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Server-only — never expose via NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_key

# Gmail SMTP for manager OTP (local Next.js send — Supabase→Gmail times out)
GMAIL_USER=ynyb73326@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=צוות טופ-אש

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ynyb73326@gmail.com

# Cron auth for /api/cron/pending-diary-reminders
CRON_SECRET=
